# Copy this file to .env and fill in the values from
# Supabase dashboard -> Project Settings -> API.
# Only PUBLIC values belong here: the project URL and the anon / publishable key.
# Never put the service_role (secret) key in this file or anywhere in the frontend.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
